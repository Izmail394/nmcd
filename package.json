{
  "name": "nmcd",
  "version": "0.1.0",
  "description": "Сервис обоснования начальной (максимальной) цены договора методом сопоставимых рыночных цен",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Izmail394/nmcd.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"src/**/*.test.js\"",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"public/**/*.js\"",
    "try-source": "node scripts/try-source.js",
    "cli": "node scripts/cli.js",
    "record-demo": "node scripts/record-demo.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "cheerio": "^1.0.0",
    "docx": "^9.0.0",
    "fastify": "^5.0.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
