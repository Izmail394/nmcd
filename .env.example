# Скопируйте в .env при необходимости. Все переменные необязательны.
PORT=3000
# off | record | replay — запись и воспроизведение ответов источников (data/snapshots)
SNAPSHOT_MODE=off
# Суффиксы хостов, для которых действуют сертификаты из ./certs
EXTRA_CA_HOSTS=.gov.ru
# Адрес, на котором сервис принимает подключения: 127.0.0.1 только локально, 0.0.0.0 для сервера
BIND=127.0.0.1
